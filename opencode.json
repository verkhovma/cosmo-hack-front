{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "TZ.md",
    "DESIGN.md"
  ],
  "plugins": [],
  "providers": {
    "routerai": {
      "name": "RouterAI",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": [
        "ROUTERAI_API_KEY"
      ],
      "settings": {
        "baseURL": "https://routerai.ru/api/v1",
        "apiKey": "{env:ROUTERAI_API_KEY}"
      },
      "models": {
        "z-ai/glm-5.3-flash": {
          "name": "GLM 5.3 Flash (Z.AI)",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "settings": {
            "reasoningEffort": "low"
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "shadcnVue": {
        "type": "local",
        "command": [
          "npx",
          "shadcn-vue@latest",
          "mcp"
        ]
      }
    }
  }
}
